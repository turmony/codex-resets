{
  "name": "codex-resets-monitor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply codex-resets-monitor --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply codex-resets-monitor --local",
    "import-state": "node scripts/import-state.mjs",
    "admin": "node scripts/admin.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.5",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.146.0"
  }
}
