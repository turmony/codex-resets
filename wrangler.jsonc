{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-resets-monitor",
  "account_id": "6d9ccd92ebbf3579d01cb8e0e7dcfef1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["30 1-22/3 * * *"] },
  "vars": {
    "MONITOR_ENABLED": "true"
  },
  "secrets": { "required": ["MAIL_EMAIL", "MAIL_SMTP_AUTH_CODE", "ADMIN_TOKEN"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "codex-resets-monitor",
    "database_id": "e3f0f69d-c582-4929-b02c-e83246faaa6a",
    "migrations_dir": "migrations"
  }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
